# Copy to .env and replace every placeholder before starting the service.
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
FERNET_KEY=REPLACE_WITH_FERNET_KEY
DATA_DIR=/app/data
MAX_UPLOAD_MB=10

# Exact browser origins allowed to call this API, comma-separated.
# Example: ALLOWED_ORIGINS=https://oa626114-boop.github.io,https://afaqsyria.runs-at.dev
ALLOWED_ORIGINS=

# Set a unique SFTP user/password before enabling the SFTP container.
SFTP_USERNAME=REPLACE_WITH_SFTP_USERNAME
SFTP_PASSWORD=REPLACE_WITH_LONG_RANDOM_SFTP_PASSWORD
